{
  "pool_id": "default-pool",
  "pool_name": "PoolForge Storage",
  "mount_point": "V:",
  "member_drives": [],
  "replication": {
    "default_replicas": 2,
    "rules": []
  },
  "balancer": {
    "strategy": "equalize_percentage",
    "auto_balance": true,
    "imbalance_threshold_percent": 15.0,
    "schedule_interval_minutes": 60,
    "rate_limit_mb_per_sec": 0
  },
  "api": {
    "host": "0.0.0.0",
    "port": 8989,
    "auth_enabled": true,
    "password_hash": "",
    "session_secret": "",
    "session_token": ""
  },
  "updates": {
    "check_enabled": true,
    "github_repo": "chrisurwin/poolforge",
    "check_interval_hours": 24
  }
}
