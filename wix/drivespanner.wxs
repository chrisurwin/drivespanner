<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product Id="*"
             Name="DriveSpanner Storage Service"
             Language="1033"
             Version="$(var.Version)"
             Manufacturer="DriveSpanner Contributors"
             UpgradeCode="C8B72D45-6F01-4A59-B3C5-18A375E9D28B">

        <Package InstallerVersion="500"
                 Compressed="yes"
                 InstallScope="perMachine"
                 InstallPrivileges="elevated"
                 Comments="High-Performance Windows Storage Pool Service" />

        <MajorUpgrade Schedule="afterInstallInitialize"
                      DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

        <MediaTemplate EmbedCab="yes" />

        <!-- Application and Installer Icons & ARP Properties -->
        <Icon Id="drivespanner.ico" SourceFile="$(var.SourceDir)\drivespanner.ico" />
        <Property Id="ARPPRODUCTICON" Value="drivespanner.ico" />
        <Property Id="ARPHELPLINK" Value="https://github.com/chrisurwin/drivespanner" />
        <Property Id="ARPURLINFOABOUT" Value="https://github.com/chrisurwin/drivespanner" />
        <Property Id="ARPCOMMENTS" Value="High-Performance Windows Storage Pool Service with file replication and drive balancing" />

        <!-- Installer Branding Bitmaps and License Agreement -->
        <WixVariable Id="WixUIBannerBmp" Value="$(var.SourceDir)\banner.bmp" />
        <WixVariable Id="WixUIDialogBmp" Value="$(var.SourceDir)\dialog.bmp" />
        <WixVariable Id="WixUILicenseRtf" Value="$(var.SourceDir)\License.rtf" />

        <!-- Drive Letter Selection Properties -->
        <Property Id="POOL_DRIVE_LETTER" Value="V:" />
        <Property Id="DRIVE_VALID" Value="1" />
        <Property Id="DRIVE_ERROR_MSG" Value="The selected drive letter is unavailable or invalid." />

        <!-- WinFsp Detection Checks -->
        <Property Id="WINFSP_INSTALLED">
            <RegistrySearch Id="WinFspRegSearch" Root="HKLM" Key="SOFTWARE\WinFsp" Name="InstallDir" Type="raw" Win64="yes" />
        </Property>
        <Property Id="WINFSP_INSTALLED_WOW64">
            <RegistrySearch Id="WinFspRegSearchWow" Root="HKLM" Key="SOFTWARE\WOW6432Node\WinFsp" Name="InstallDir" Type="raw" />
        </Property>

        <!-- Embedded Script for Drive Letter Detection, WinFsp Helpers, and Config File Application -->
        <Binary Id="ValidateDriveScript" SourceFile="$(var.SourceDir)\validate_drive.js" />
        <CustomAction Id="InitDriveLetterAction" BinaryKey="ValidateDriveScript" JScriptCall="InitDriveLetter" Execute="immediate" Return="check" />
        <CustomAction Id="ValidateDriveLetterAction" BinaryKey="ValidateDriveScript" JScriptCall="ValidateDriveLetter" Execute="immediate" Return="check" />
        <CustomAction Id="SetApplyConfigData" Property="ApplyConfigDriveLetterAction" Value="[INSTALLFOLDER]|[POOL_DRIVE_LETTER]" />
        <CustomAction Id="ApplyConfigDriveLetterAction" BinaryKey="ValidateDriveScript" JScriptCall="ApplyConfigDriveLetter" Execute="deferred" Impersonate="no" Return="ignore" />
        <CustomAction Id="InstallWinFspAction" BinaryKey="ValidateDriveScript" JScriptCall="InstallWinFsp" Execute="immediate" Return="check" />
        <CustomAction Id="OpenWinFspUrlAction" BinaryKey="ValidateDriveScript" JScriptCall="OpenWinFspUrl" Execute="immediate" Return="check" />
        <CustomAction Id="CheckWinFspStatusAction" BinaryKey="ValidateDriveScript" JScriptCall="CheckWinFspStatus" Execute="immediate" Return="check" />

        <!-- Directory Structure: Install to %ProgramFiles%\DriveSpanner -->
        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="ProgramFiles64Folder">
                <Directory Id="INSTALLFOLDER" Name="DriveSpanner" />
            </Directory>
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ApplicationProgramsFolder" Name="DriveSpanner" />
            </Directory>
        </Directory>

        <!-- Files and Components -->
        <DirectoryRef Id="INSTALLFOLDER">
            <!-- Core Daemon Executable and Windows Service Registration -->
            <Component Id="DriveSpannerServiceComponent" Guid="E63B4F55-9B21-4A59-8664-9F8F87C9DAA2" Win64="yes">
                <File Id="DriveSpannerExe"
                      Source="$(var.SourceDir)\drivespanner.exe"
                      KeyPath="yes" />

                <!-- Install as Windows Service configured for automatic boot startup -->
                <ServiceInstall Id="DriveSpannerServiceInstaller"
                                Name="DriveSpannerService"
                                DisplayName="DriveSpanner Storage Service"
                                Description="Aggregates physical hard drives into an expandable storage pool with file replication and background balancing."
                                Type="ownProcess"
                                Start="auto"
                                ErrorControl="normal"
                                Arguments="service run" />

                <!-- Service Lifecycle: Start on install, stop on update/uninstall, delete on uninstall/upgrade -->
                <ServiceControl Id="DriveSpannerServiceControl"
                                Name="DriveSpannerService"
                                Start="install"
                                Stop="both"
                                Remove="both"
                                Wait="yes" />
            </Component>

            <!-- Configuration File: Never overwritten on upgrades to protect disks and user settings -->
            <Component Id="DriveSpannerConfigComponent" Guid="6E0B195C-5D63-42AC-8263-5F114227CE73" Win64="yes" NeverOverwrite="yes" Permanent="yes">
                <File Id="DriveSpannerConfigFile"
                      Source="$(var.SourceDir)\config.json"
                      KeyPath="yes" />
            </Component>

            <!-- WinFsp Prerequisite Helper Script -->
            <Component Id="WinFspPrereqScript" Guid="A78E31B2-7801-4475-A08D-E9237B316C4D" Win64="yes">
                <File Id="CheckWinFspScript"
                      Source="$(var.SourceDir)\check_winfsp.ps1"
                      KeyPath="yes" />
            </Component>

            <!-- Uninstall Shortcut in Program Files Directory -->
            <Component Id="ProgramFilesUninstallShortcut" Guid="7C3F8B2D-91E4-4C23-B245-A67E824F315D" Win64="yes">
                <Shortcut Id="UninstallInProgramFiles"
                          Name="Uninstall DriveSpanner"
                          Description="Uninstalls DriveSpanner Storage Service from this computer"
                          Target="[System64Folder]msiexec.exe"
                          Arguments="/x [ProductCode]"
                          Icon="drivespanner.ico" />
                <CreateFolder />
            </Component>
        </DirectoryRef>

        <!-- Start Menu Shortcuts -->
        <DirectoryRef Id="ApplicationProgramsFolder">
            <Component Id="ApplicationShortcut" Guid="4D82390F-238B-4B79-BF4A-1EE28701B27A" Win64="yes">
                <Shortcut Id="OpenWebDashboard"
                          Name="DriveSpanner Web Dashboard"
                          Description="Open DriveSpanner management interface at http://localhost:8989"
                          Target="[SystemFolder]cmd.exe"
                          Arguments="/c start http://localhost:8989"
                          Icon="drivespanner.ico" />
                <Shortcut Id="ApplicationCLI"
                          Name="DriveSpanner CLI"
                          Description="Open DriveSpanner CLI status"
                          Target="[#DriveSpannerExe]"
                          Arguments="status"
                          WorkingDirectory="INSTALLFOLDER"
                          Icon="drivespanner.ico" />
                <Shortcut Id="UninstallShortcut"
                          Name="Uninstall DriveSpanner"
                          Description="Uninstalls DriveSpanner Storage Service from this computer"
                          Target="[System64Folder]msiexec.exe"
                          Arguments="/x [ProductCode]"
                          Icon="drivespanner.ico" />
                <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall" />
                <RegistryValue Root="HKLM" Key="Software\DriveSpanner" Name="installed" Type="integer" Value="1" KeyPath="yes" />
            </Component>
        </DirectoryRef>

        <!-- Feature Definitions -->
        <Feature Id="MainApplication" Title="DriveSpanner Core Service" Level="1">
            <ComponentRef Id="DriveSpannerServiceComponent" />
            <ComponentRef Id="DriveSpannerConfigComponent" />
            <ComponentRef Id="WinFspPrereqScript" />
            <ComponentRef Id="ProgramFilesUninstallShortcut" />
            <ComponentRef Id="ApplicationShortcut" />
        </Feature>

        <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

        <!-- Custom User Interface Flow with Drive Letter Selection and Validation -->
        <UI Id="WixUI_DriveSpanner">
            <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
            <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
            <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />

            <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
            <Property Id="WixUI_Mode" Value="InstallDir" />

            <DialogRef Id="BrowseDlg" />
            <DialogRef Id="DiskCostDlg" />
            <DialogRef Id="ErrorDlg" />
            <DialogRef Id="FatalError" />
            <DialogRef Id="FilesInUse" />
            <DialogRef Id="MsiRMFilesInUse" />
            <DialogRef Id="PrepareDlg" />
            <DialogRef Id="ProgressDlg" />
            <DialogRef Id="ResumeDlg" />
            <DialogRef Id="UserExit" />
            <DialogRef Id="WelcomeDlg" />
            <DialogRef Id="LicenseAgreementDlg" />
            <DialogRef Id="InstallDirDlg" />
            <DialogRef Id="VerifyReadyDlg" />
            <DialogRef Id="MaintenanceWelcomeDlg" />
            <DialogRef Id="MaintenanceTypeDlg" />
            <DialogRef Id="InvalidDirDlg" />

            <Dialog Id="PoolDriveLetterDlg" Width="370" Height="270" Title="[ProductName] Setup">
                <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
                <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
                <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Virtual Pool Drive Letter" />
                <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Choose the virtual drive letter for your aggregated storage pool." />

                <Control Id="IntroText" Type="Text" X="20" Y="60" Width="330" Height="30" Text="DriveSpanner will mount your storage pool as a unified drive letter in Windows Explorer. Enter an available drive letter below:" />
                
                <Control Id="DriveLetterLabel" Type="Text" X="20" Y="102" Width="90" Height="15" Text="&amp;Drive Letter:" />
                <Control Id="DriveLetterEdit" Type="Edit" X="115" Y="100" Width="50" Height="18" Property="POOL_DRIVE_LETTER" Text="{10}" />
                <Control Id="DriveLetterHint" Type="Text" X="175" Y="102" Width="175" Height="20" Text="(e.g. V: or Z:)" />

                <Control Id="InfoBox" Type="Text" X="20" Y="135" Width="330" Height="40" Text="When you click Next, the installer will verify that this drive letter is available and not currently used by any physical drive, partition, DVD-ROM, or network share." />

                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
                <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back">
                    <Publish Event="NewDialog" Value="InstallDirDlg">1</Publish>
                </Control>
                <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Next">
                    <Publish Event="DoAction" Value="ValidateDriveLetterAction">1</Publish>
                    <Publish Event="SpawnDialog" Value="InvalidDriveDlg">DRIVE_VALID = "0"</Publish>
                    <Publish Event="NewDialog" Value="VerifyReadyDlg">DRIVE_VALID = "1"</Publish>
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
                    <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
                </Control>
            </Dialog>

            <Dialog Id="InvalidDriveDlg" Width="280" Height="110" Title="Drive Letter Unavailable">
                <Control Id="ErrorIcon" Type="Icon" X="15" Y="15" Width="24" Height="24" FixedSize="yes" IconSize="32" Text="WixUI_Ico_Exclam" />
                <Control Id="ErrorText" Type="Text" X="48" Y="15" Width="215" Height="50" Property="DRIVE_ERROR_MSG" Text="The selected drive letter is unavailable or invalid." />
                <Control Id="OkButton" Type="PushButton" X="110" Y="75" Width="60" Height="17" Default="yes" Cancel="yes" Text="OK">
                    <Publish Event="EndDialog" Value="Return">1</Publish>
                </Control>
            </Dialog>

            <Dialog Id="WinFspPrereqDlg" Width="370" Height="270" Title="[ProductName] Setup">
                <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
                <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
                <Control Id="Title" Type="Text" X="15" Y="6" Width="220" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Prerequisite: WinFsp Required" />
                <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Filesystem driver required for virtual storage pool mounting." />

                <Control Id="PrereqIcon" Type="Icon" X="20" Y="58" Width="24" Height="24" FixedSize="yes" IconSize="32" Text="WixUI_Ico_Exclam" />
                <Control Id="PrereqText" Type="Text" X="55" Y="58" Width="295" Height="45" Text="DriveSpanner requires the WinFsp (Windows File System Proxy) driver to mount your pooled storage into Windows Explorer. WinFsp was not detected on this system." />

                <Control Id="InstallBtn" Type="PushButton" X="55" Y="112" Width="185" Height="24" Default="yes" Text="&amp;Install WinFsp Automatically">
                    <Publish Event="DoAction" Value="InstallWinFspAction">1</Publish>
                    <Publish Event="DoAction" Value="CheckWinFspStatusAction">1</Publish>
                    <Publish Event="NewDialog" Value="InstallDirDlg">WINFSP_INSTALLED</Publish>
                </Control>

                <Control Id="WebBtn" Type="PushButton" X="55" Y="144" Width="185" Height="20" Text="&amp;Open WinFsp Download Page">
                    <Publish Event="DoAction" Value="OpenWinFspUrlAction">1</Publish>
                </Control>

                <Control Id="NoteText" Type="Text" X="55" Y="174" Width="295" Height="35" Text="Click 'Install WinFsp Automatically' to download and install now. If you prefer to install WinFsp later, click Next to continue." />

                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
                <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back">
                    <Publish Event="NewDialog" Value="LicenseAgreementDlg">1</Publish>
                </Control>
                <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Text="&amp;Next">
                    <Publish Event="DoAction" Value="CheckWinFspStatusAction">1</Publish>
                    <Publish Event="NewDialog" Value="InstallDirDlg">1</Publish>
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
                    <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
                </Control>
            </Dialog>

            <!-- WelcomeDlg navigation -->
            <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg">NOT Installed</Publish>
            <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg">Installed AND NOT PATCH</Publish>
            <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg">Installed AND PATCH</Publish>

            <!-- LicenseAgreementDlg navigation -->
            <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg">1</Publish>
            <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="WinFspPrereqDlg" Order="2">NOT Installed AND NOT WINFSP_INSTALLED AND NOT WINFSP_INSTALLED_WOW64 AND NOT (SKIP_WINFSP_CHECK = "1")</Publish>
            <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="3">Installed OR WINFSP_INSTALLED OR WINFSP_INSTALLED_WOW64 OR (SKIP_WINFSP_CHECK = "1")</Publish>


            <!-- InstallDirDlg navigation: Strictly routes Next to PoolDriveLetterDlg -->
            <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WinFspPrereqDlg" Order="1">NOT Installed AND NOT WINFSP_INSTALLED AND NOT WINFSP_INSTALLED_WOW64 AND NOT (SKIP_WINFSP_CHECK = "1")</Publish>
            <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg" Order="2">Installed OR WINFSP_INSTALLED OR WINFSP_INSTALLED_WOW64 OR (SKIP_WINFSP_CHECK = "1")</Publish>
            <Publish Dialog="InstallDirDlg" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1">1</Publish>
            <Publish Dialog="InstallDirDlg" Control="Next" Event="DoAction" Value="WixUIValidatePath" Order="2">NOT WIXUI_DONTVALIDATEPATH</Publish>
            <Publish Dialog="InstallDirDlg" Control="Next" Event="SpawnDialog" Value="InvalidDirDlg" Order="3"><![CDATA[NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID<>"1"]]></Publish>
            <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="PoolDriveLetterDlg" Order="4">WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID="1"</Publish>
            <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1">1</Publish>
            <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2">1</Publish>

            <!-- BrowseDlg navigation -->
            <Publish Dialog="BrowseDlg" Control="OK" Event="DoAction" Value="WixUIValidatePath" Order="1">1</Publish>
            <Publish Dialog="BrowseDlg" Control="OK" Event="SpawnDialog" Value="InvalidDirDlg" Order="2"><![CDATA[NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID<>"1"]]></Publish>

            <!-- VerifyReadyDlg navigation: Back strictly routes to PoolDriveLetterDlg for new installs -->
            <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="PoolDriveLetterDlg" Order="1">NOT Installed</Publish>
            <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2">Installed AND NOT PATCH</Publish>
            <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="3">Installed AND PATCH</Publish>

            <!-- Maintenance dialog navigation -->
            <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg">1</Publish>
            <Publish Dialog="MaintenanceTypeDlg" Control="ChangeButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
            <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
            <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
            <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg">1</Publish>
        </UI>

        <UIRef Id="WixUI_DriveSpanner" />
        <UIRef Id="WixUI_ErrorProgressText" />

        <!-- Elevated deferred action to stop and delete any pre-existing services before InstallServices runs -->
        <CustomAction Id="CleanupExistingServiceAction"
                      Directory="TARGETDIR"
                      ExeCommand="cmd.exe /c &quot;net.exe stop PoolForgeService &amp; sc.exe delete PoolForgeService &amp; net.exe stop DriveSpannerService &amp; sc.exe delete DriveSpannerService&quot;"
                      Execute="deferred"
                      Impersonate="no"
                      Return="ignore" />

        <!-- Initialize candidate drive letter on installer UI startup -->
        <InstallUISequence>
            <Custom Action="InitDriveLetterAction" Before="ExecuteAction">NOT Installed</Custom>
        </InstallUISequence>

        <!-- Apply chosen drive letter to config.json before starting the Windows service -->
        <InstallExecuteSequence>
            <Custom Action="CleanupExistingServiceAction" Before="InstallServices">NOT Installed OR REINSTALL</Custom>
            <Custom Action="SetApplyConfigData" Before="ApplyConfigDriveLetterAction">NOT Installed</Custom>
            <Custom Action="ApplyConfigDriveLetterAction" After="InstallFiles">NOT Installed</Custom>
        </InstallExecuteSequence>

    </Product>
</Wix>
